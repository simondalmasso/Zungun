{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zungun",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zungun-pilot-v0-canary",
      "database_id": "9493de0d-c6ad-4090-8731-5b902b03ae40",
      "preview_database_id": "9493de0d-c6ad-4090-8731-5b902b03ae40",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations"
    }
  ]
}
